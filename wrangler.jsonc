{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "scrum-master-tool",
  "main": "./cloudflare-worker.mjs",
  "compatibility_date": "2026-08-07",
  "assets": {
    "directory": "./apps/sm-tool/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "PILOT_ACCESS",
        "class_name": "PilotAccessStore"
      }
    ]
  },
  "migrations": [
    {
      "tag": "pilot-access-v1",
      "new_sqlite_classes": ["PilotAccessStore"]
    }
  ]
}
