{
  "name": "scrum-master-tool",
  "version": "0.5.7",
  "private": true,
  "description": "Offline Scrum Master tool for local Jira CSV exports",
  "type": "module",
  "scripts": {
    "analyze": "tsx src/cli.ts",
    "generate:renew-launchers": "tsx src/generate-renew-launchers.ts",
    "test:windows:renew": "node scripts/windows-renew-smoke.mjs",
    "jira:pull": "tsx src/jira-pull.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && npm --prefix apps/sm-tool run typecheck",
    "check": "npm run typecheck && npm test && npm run sm:build",
    "sm:install": "npm --prefix apps/sm-tool install",
    "sm:dev": "npm --prefix apps/sm-tool run dev",
    "sm:build": "npm --prefix apps/sm-tool run build"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/wicg-file-system-access": "^2023.10.5",
    "tsx": "^4.23.5",
    "typescript": "^5.8.2",
    "vitest": "^3.2.7"
  }
}
